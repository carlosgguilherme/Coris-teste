{
    "name": "carlosgguilherme/coris-seguros-api",
    "description": "API de gestão de apólices de seguro viagem",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/migrate.php",
        "serve": "php -S 0.0.0.0:8000 -t public"
    },
    "config": {
        "sort-packages": true
    }
}
